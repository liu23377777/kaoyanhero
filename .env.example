# 复制为 .env 后，至少填写一个平台的 API Key。
PORT=3000

# Supabase 多用户模式。不填写时自动回退到本机单用户模式。
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 用于加密每位用户的 Habitica Token，至少 32 个随机字符，部署后不要更换。
APP_ENCRYPTION_KEY=
# 部署后的完整网址，例如 https://kaoyan-hero.onrender.com
PUBLIC_APP_URL=http://localhost:3000
# 每位用户每天最多提交的 AI 打卡次数
DAILY_AI_REQUEST_LIMIT=10
# 仅在 Render/Nginx 等可信反向代理会覆盖 X-Forwarded-For 时启用
TRUST_PROXY=false
# 在 Supabase 中配置 Google Provider 后改成 true
ENABLE_GOOGLE_AUTH=false

# 阿里云百炼 / Qwen（北京地域 OpenAI 兼容接口）
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-vl-8b-instruct

# DeepSeek V4.1 Flash（官方原生多模态，API 模型名为 deepseek-flash）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 智谱 GLM（GLM-4.6V-Flash 官方标注为完全免费）
ZHIPU_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.6v-flash

# 火山方舟 / 豆包。模型名也可以填写控制台创建的推理接入点 ID。
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-1-6-vision-250815

# 安知鱼或其他 OpenAI Chat Completions 兼容中转站
ANZHIYU_API_KEY=
ANZHIYU_BASE_URL=https://sub.anzhiyu.com/v1
ANZHIYU_MODEL=

# 任意其他 OpenAI-compatible 服务
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# Habitica：打卡成功后自动完成指定 Daily / To Do / Habit
# User ID 与 API Token 可在 Habitica 设置 > API 中找到；请勿把 Token 放到前端。
HABITICA_USER_ID=
HABITICA_API_TOKEN=
HABITICA_TASK_ID=
# 官方要求的 X-Client，格式建议为“你的Habitica用户ID-KaoyanHero”
HABITICA_CLIENT_ID=
